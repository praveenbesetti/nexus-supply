{
  "name": "nexus-supply",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/cds-mtxs": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db/nexus-supply.sqlite"
          }
        },
        "auth": {
          "kind": "mocked-auth",
          "users": {
            "alice": {
              "roles": [
                "ProcurementManager"
              ]
            },
            "bob": {
              "roles": [
                "User"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "S4BusinessPartnerService": {
        "kind": "odata-v2",
        "model": "srv/external/s4-suppliers",
        "[test]": {
          "impl": "srv/external/s4-suppliers-mock.js"
        },
        "[development]": {
          "impl": "srv/external/s4-suppliers-mock.js"
        },
        "[production]": {
          "credentials": {
            "destination": "S4_HANA_DESTINATION"
          }
        }
      },
      "messaging": {
        "kind": "local-messaging"
      },
      "queue": {
        "kind": "persistent-queue"
      },
      "[with-mtx]": {
        "multitenancy": true
      }
    },
    "profile": "with-mtx-sidecar"
  }
}
