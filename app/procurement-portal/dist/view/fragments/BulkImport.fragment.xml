<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        id="bulkDialog"
        title="{vm>/bulk/title}"
        contentWidth="48rem"
        contentHeight="32rem"
        stretchOnPhone="true"
        busy="{vm>/bulk/saving}">
        <content>
            <VBox class="dialogContent">
                <MessageStrip
                    text="{vm>/bulk/help}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                <TextArea
                    id="bulkInput"
                    value="{vm>/bulk/text}"
                    rows="12"
                    growing="true"
                    width="100%"
                    placeholder="{vm>/bulk/placeholder}"/>
                <Text
                    text="{vm>/bulk/result}"
                    wrapping="true"
                    class="sapUiSmallMarginTop"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Import rows" type="Emphasized" press="onRunBulkImport"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseBulk"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
