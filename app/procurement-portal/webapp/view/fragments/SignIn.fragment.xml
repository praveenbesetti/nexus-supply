<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        id="signInDialog"
        title="Local development sign-in"
        contentWidth="24rem"
        stretchOnPhone="true">
        <content>
            <VBox class="dialogContent">
                <MessageStrip
                    text="For local CAP mocked authentication only. Production SSO uses your existing session."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                <Label text="Username" required="true"/>
                <Input id="usernameInput" value="alice"/>
                <Label text="Password" required="true" class="sapUiSmallMarginTop"/>
                <Input id="passwordInput" type="Password"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Sign in" type="Emphasized" press="onSignIn"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseSignIn"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
